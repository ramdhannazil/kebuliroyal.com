{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/admin\\.html",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/admin",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/hahaadmin",
      "dest": "/admin.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
